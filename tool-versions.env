# Phiên bản công cụ chạy dạng container trong pipeline — pin để kết quả quét lặp lại được.
# [CHƯA XÁC MINH] Kiểm tra tag mới nhất trước lần chạy đầu tiên và cập nhật qua PR:
#   Trivy:    https://github.com/aquasecurity/trivy/releases
#   Gitleaks: https://github.com/gitleaks/gitleaks/releases
#   Hadolint: https://github.com/hadolint/hadolint/releases
#   actionlint: https://github.com/rhysd/actionlint/releases
TRIVY_IMAGE=aquasec/trivy:0.67.2
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.28.0
HADOLINT_IMAGE=hadolint/hadolint:v2.14.0
ACTIONLINT_IMAGE=rhysd/actionlint:1.7.8
